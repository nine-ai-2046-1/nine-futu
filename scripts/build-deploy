#!/bin/bash
set -e

# nine-futu build and deploy script
# Builds both library and CLI, then copies CLI to ~/.local/bin/

echo "Building nine-futu workspace..."
cargo build --release

echo "Copying nine-futu to ~/.local/bin..."
mkdir -p ~/.local/bin
cp target/release/nine-futu ~/.local/bin/

echo "Done!"
echo "Binary: ~/.local/bin/nine-futu"
~/.local/bin/nine-futu --version
